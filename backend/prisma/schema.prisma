generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductInteractionType {
  VIEW
  ADD_TO_CART
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum ReviewReportReason {
  SPAM
  HARASSMENT
  OFF_TOPIC
  FAKE_REVIEW
  INAPPROPRIATE
  OTHER
}

enum ReviewReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

enum ReviewModerationActionType {
  HIDE
  RESTORE
  REMOVE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.VarChar(255)
  firstName    String?   @db.VarChar(100)
  lastName     String?   @db.VarChar(100)
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  seller       Seller?
  addresses    Address[]
  cart         Cart?
  orders       Order[]
  reviews      Review[]
  wishlist     Wishlist[]
  searchEvents SearchEvent[]
  interactions ProductInteraction[]
  reportedReviewReports ReviewReport[] @relation("ReviewReporter")
  resolvedReviewReports ReviewReport[] @relation("ReviewReportModerator")
  reviewModerationActions ReviewModerationAction[]
}

model Seller {
  id          String       @id @default(cuid())
  userId      String       @unique
  storeName   String       @unique @db.VarChar(191)
  slug        String       @unique @db.VarChar(191)
  description String?      @db.Text
  status      SellerStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  orderItems  OrderItem[]
  allocations SellerOrderAllocation[]
  fulfillments Fulfillment[]
}

model Category {
  id        String     @id @default(cuid())
  name      String     @db.VarChar(191)
  slug      String     @unique @db.VarChar(191)
  parentId  String?
  imageUrl  String?    @db.VarChar(2048)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
}

model Product {
  id            String        @id @default(cuid())
  sellerId      String
  categoryId    String
  title         String        @db.VarChar(255)
  slug          String        @unique @db.VarChar(191)
  description   String        @db.Text
  brand         String?       @db.VarChar(191)
  basePrice     Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD") @db.Char(3)
  stockQuantity Int           @default(0)
  status        ProductStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  seller        Seller        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  attributes    ProductAttribute[]
  variants      ProductVariant[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlists     Wishlist[]
  interactions  ProductInteraction[]

  @@index([categoryId, status])
  @@index([sellerId, status])
  @@index([brand])
  @@index([status, basePrice])
  @@index([status, createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  url       String   @db.VarChar(2048)
  altText   String?  @db.VarChar(255)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@index([variantId])
}

model Attribute {
  id                String                    @id @default(cuid())
  name              String                    @unique @db.VarChar(191)
  code              String                    @unique @db.VarChar(191)
  createdAt         DateTime                  @default(now())
  productAttributes ProductAttribute[]
  variantAttributes ProductVariantAttribute[]
}

model ProductAttribute {
  id          String    @id @default(cuid())
  productId   String
  attributeId String
  value       String    @db.VarChar(500)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([productId, attributeId])
  @@index([attributeId, value])
}

model ProductVariant {
  id            String                    @id @default(cuid())
  productId     String
  sku           String                    @unique @db.VarChar(191)
  price         Decimal?                  @db.Decimal(12, 2)
  stockQuantity Int                       @default(0)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  product       Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes    ProductVariantAttribute[]
  images        ProductImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId])
}

model ProductVariantAttribute {
  id          String         @id @default(cuid())
  variantId   String
  attributeId String
  value       String         @db.VarChar(500)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute   Attribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([variantId, attributeId])
  @@index([attributeId, value])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@unique([cartId, productId, variantId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?  @db.VarChar(100)
  recipient  String   @db.VarChar(191)
  line1      String   @db.VarChar(191)
  line2      String?  @db.VarChar(191)
  city       String   @db.VarChar(100)
  state      String?  @db.VarChar(100)
  postalCode String   @db.VarChar(30)
  country    String   @db.Char(2)
  phone      String?  @db.VarChar(30)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          OrderStatus @default(PENDING)
  currency        String      @default("USD") @db.Char(3)
  subtotalAmount  Decimal     @db.Decimal(12, 2)
  shippingAmount  Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  shippingAddress Json
  paymentProvider String?     @db.VarChar(50)
  paymentRef      String?     @db.VarChar(191)
  paymentStatus   PaymentStatus @default(PENDING)
  shippingMethodId String?      @db.VarChar(50)
  shippingMethodName String?    @db.VarChar(100)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payments        Payment[]
  allocations     SellerOrderAllocation[]
  fulfillments    Fulfillment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@unique([paymentProvider, paymentRef])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  sellerId    String
  productName String          @db.VarChar(255)
  variantName String?         @db.VarChar(500)
  sku         String?         @db.VarChar(191)
  quantity    Int
  unitPrice   Decimal         @db.Decimal(12, 2)
  totalPrice  Decimal         @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  seller      Seller          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  fulfillmentItems FulfillmentItem[]

  @@index([orderId])
  @@index([sellerId, createdAt])
}

model Fulfillment {
  id                String            @id @default(cuid())
  orderId           String
  sellerId          String
  status            FulfillmentStatus @default(PENDING)
  shippingMethodId  String            @db.VarChar(50)
  shippingMethodName String           @db.VarChar(100)
  shippingCost      Decimal           @db.Decimal(12, 2)
  trackingNumber    String?           @db.VarChar(191)
  carrier           String?           @db.VarChar(100)
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller            Seller            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items             FulfillmentItem[]

  @@unique([orderId, sellerId])
  @@index([orderId, status])
  @@index([sellerId, status])
}

model FulfillmentItem {
  id            String      @id @default(cuid())
  fulfillmentId String
  orderItemId   String
  quantity      Int
  createdAt     DateTime    @default(now())
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([fulfillmentId, orderItemId])
  @@index([fulfillmentId])
  @@index([orderItemId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        @db.VarChar(50)
  providerPaymentId String?       @unique @db.VarChar(255)
  checkoutSessionId String?       @unique @db.VarChar(255)
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.Char(3)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@index([orderId, status])
  @@index([provider, status])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  providerRefundId String?      @unique @db.VarChar(255)
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @db.Char(3)
  status           RefundStatus @default(PENDING)
  reason           String?      @db.VarChar(255)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, status])
}

model ProcessedStripeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique @db.VarChar(255)
  type        String   @db.VarChar(100)
  processedAt DateTime @default(now())
}

model SellerOrderAllocation {
  id                String   @id @default(cuid())
  orderId           String
  sellerId          String
  grossAmount       Decimal  @db.Decimal(12, 2)
  platformFeeAmount Decimal  @db.Decimal(12, 2)
  sellerNetAmount   Decimal  @db.Decimal(12, 2)
  feeRate           Decimal  @db.Decimal(5, 2)
  currency          String   @db.Char(3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller            Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([orderId, sellerId])
  @@index([sellerId, createdAt])
}

model Review {
  id               String       @id @default(cuid())
  userId           String
  productId        String
  rating           Int
  title            String?      @db.VarChar(255)
  body             String?      @db.Text
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PUBLISHED)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  reports          ReviewReport[]
  moderationActions ReviewModerationAction[]

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([productId, status, rating])
  @@index([userId, createdAt])
}

model ReviewReport {
  id                String             @id @default(cuid())
  reviewId          String
  reporterUserId    String
  reason            ReviewReportReason
  details           String?            @db.VarChar(1000)
  status            ReviewReportStatus @default(OPEN)
  resolvedAt        DateTime?
  resolvedByUserId  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  review             Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter           User               @relation("ReviewReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  resolvedBy         User?              @relation("ReviewReportModerator", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([reviewId, reporterUserId])
  @@index([reviewId, createdAt])
  @@index([status, createdAt])
  @@index([reporterUserId, createdAt])
}

model ReviewModerationAction {
  id          String                     @id @default(cuid())
  reviewId    String
  adminUserId String
  action      ReviewModerationActionType
  reason      String?                    @db.VarChar(1000)
  createdAt   DateTime                   @default(now())
  review      Review                     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  adminUser   User                       @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([reviewId, createdAt])
  @@index([adminUserId, createdAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model SearchEvent {
  id        String   @id @default(cuid())
  query     String   @db.VarChar(100)
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query, createdAt])
  @@index([userId, createdAt])
}

model ProductInteraction {
  id        String                 @id @default(cuid())
  userId    String
  productId String
  type      ProductInteractionType
  createdAt DateTime               @default(now())
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([productId, createdAt])
}
