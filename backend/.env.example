# MySQL connection used by Prisma. Create this database before running migrations.
DATABASE_URL="mysql://best_value_user:change_me@localhost:3306/best_value"

# HTTP server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Required: use a unique, randomly generated value of at least 32 characters.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
