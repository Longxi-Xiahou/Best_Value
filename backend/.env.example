# MySQL connection used by Prisma. Create this database before running migrations.
DATABASE_URL="mysql://best_value_user:change_me@localhost:3306/best_value"

# HTTP server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Use a long, unique random value in real environments. Required before Phase 2 auth is enabled.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
